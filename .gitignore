# build output and caches - rebuildable, and permanent once committed
.pio/
.pioenvs/
.piolibdeps/
build/
dist/
__pycache__/
*.pyc
*.pyo
.venv/
venv/
env/
node_modules/

# local editor state
.vscode/.browse*
.vscode/c_cpp_properties.json
.vscode/launch.json
.vscode/ipch/
*.code-workspace

# large/derived artefacts
*.sqlite3
*.db-journal
*.o
*.elf
*.map

# secrets must never enter history - use environment variables
.env
*.pem
*.key
credentials.json

# The generic display/touch bring-up base this firmware was seeded from is a
# separate concern and now lives outside the project, at
# ../ESP32-S3-Touch-base. It is reference material, not part of this build,
# and it carries an archive of the unrelated project it came from - including
# credential files. Keep it out of this repo.
ESP32-S3-Touch/

# Local editor state - machine-specific paths, no value to anyone else.
.vscode/

# clangd index config - local editor state.
.clangd
